---
title: Writing
description: Every post on Field Notes, newest first, about building fast and considered websites.
---
<template>
<p class="mira-eyebrow">Writing &middot; {{ collections.posts.length }} posts</p>
<h1>{{ page.title }}</h1>
<ol class="posts" role="list">
  {#each collections.posts as post}
  <li>
    <a href="{{ post.url }}">
      <h2 mira-morph="title-{{ post.slug }}">{{ post.title }}</h2>
      {#if post.description}<p>{{ post.description }}</p>{/if}
      <time class="mira-eyebrow" datetime="{{ post.date }}">{{ post.date }}</time>
    </a>
  </li>
  {/each}
</ol>
</template>

<style>
h1 { margin-top: var(--space-3); }
.posts { list-style: none; padding: 0; margin-top: var(--space-12); }
.posts li + li { border-top: 1px solid var(--line); }
.posts a {
  display: grid;
  gap: var(--space-2);
  padding-block: var(--space-6);
  color: inherit;
  text-decoration: none;
}
.posts h2 { width: fit-content; transition: color 160ms; }
.posts a:hover h2 { color: var(--ink-muted); }
.posts p { color: var(--ink-muted); }
</style>
